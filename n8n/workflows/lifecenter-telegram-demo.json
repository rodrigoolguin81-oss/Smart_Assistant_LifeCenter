      {
        "id": "d0209849-3c3d-4cc5-8f56-5ee4602d59d4",
        "name": "Seudonimizar",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          448,
          0
        ],
        "parameters": {
          "mode": "runOnceForEachItem",
          "language": "javaScript",
          "jsCode": "// Port of app/domain/answering/pseudonymize.py (SPEC-001 R4, CHG-001 D2).\nconst EMAIL = /[\\p{L}\\p{N}_.+-]+@[\\p{L}\\p{N}_-]+(?:\\.[\\p{L}\\p{N}_-]+)+/gu;\nconst NIE = /(?<![\\p{L}\\p{N}_])[XYZxyz][\\s-]?\\p{Nd}{7}[\\s-]?[A-Za-z](?![\\p{L}\\p{N}_])/gu;\nconst DNI = /(?<![\\p{L}\\p{N}_])\\p{Nd}{8}[\\s-]?[A-Za-z](?![\\p{L}\\p{N}_])/gu;\nconst PHONE = /(?<![\\p{L}\\p{N}_+])(?:(?:\\+|00)34[\\s.-]?)?[6789]\\p{Nd}{2}(?:[\\s.-]?\\p{Nd}){6}(?![\\p{L}\\p{N}_])/gu;\nconst NAME_INTRO = /(?<![\\p{L}\\p{N}_])(?:me\\s+llamo|mi\\s+nombre\\s+es|a\\s+nombre\\s+de)\\s+/giu;\nconst WORD = /[A-Za-zÁÉÍÓÚÜÑáéíóúüñ]+/y;\nconst SPACES = /\\s+/y;\nconst NAME_CONNECTORS = new Set(['de', 'del', 'la', 'las', 'los']);\nconst MAX_NAME_WORDS = 4;\nconst NOT_A_SURNAME = new Set([\n  'y', 'e', 'o', 'u', 'que', 'quiero', 'quisiera', 'querría', 'para', 'por', 'con', 'sin',\n  'de', 'del', 'la', 'el', 'los', 'las', 'un', 'una', 'tengo', 'necesito', 'me', 'mi',\n  'a', 'al', 'en', 'es', 'soy', 'pero', 'porque', 'gracias', 'hola', 'buenas', 'buenos',\n  'cuánto', 'cuanto', 'cómo', 'como', 'qué', 'cuándo', 'cuando', 'pido', 'pedir',\n]);\n\nfunction matchAt(re, text, pos) {\n  re.lastIndex = pos;\n  const m = re.exec(text);\n  return m ? { text: m[0], end: pos + m[0].length } : null;\n}\nconst isUpperChar = (c) => c !== c.toLowerCase();\nconst isLowerWord = (w) => w === w.toLowerCase() && w !== w.toUpperCase();\n\nfunction capitalizedNameEnd(text, first) {\n  let end = first.end;\n  let words = 1;\n  let cursor = first.end;\n  while (words < MAX_NAME_WORDS) {\n    let connectorsEnd = cursor;\n    let word = null;\n    while (true) {\n      const gap = matchAt(SPACES, text, connectorsEnd);\n      word = gap ? matchAt(WORD, text, gap.end) : null;\n      if (word && NAME_CONNECTORS.has(word.text.toLowerCase())) {\n        connectorsEnd = word.end;\n        continue;\n      }\n      break;\n    }\n    if (!word || !isUpperChar(word.text[0])) break;\n    end = cursor = word.end;\n    words += 1;\n  }\n  return end;\n}\n\nfunction lowercaseNameEnd(text, first) {\n  if (NOT_A_SURNAME.has(first.text.toLowerCase())) return null;\n  const gap = matchAt(SPACES, text, first.end);\n  const second = gap ? matchAt(WORD, text, gap.end) : null;\n  if (second && isLowerWord(second.text) && !NOT_A_SURNAME.has(second.text)) return second.end;\n  return first.end;\n}\n\nfunction nameEnd(text, start) {\n  const first = matchAt(WORD, text, start);\n  if (!first) return null;\n  return isUpperChar(first.text[0]) ? capitalizedNameEnd(text, first) : lowercaseNameEnd(text, first);\n}\n\nfunction replaceNames(text) {\n  let out = '';\n  let pos = 0;\n  NAME_INTRO.lastIndex = 0;\n  let intro;\n  while ((intro = NAME_INTRO.exec(text)) !== null) {\n    const introEnd = intro.index + intro[0].length;\n    if (intro.index < pos) continue;\n    const end = nameEnd(text, introEnd);\n    if (end === null) continue;\n    out += text.slice(pos, introEnd) + '[NOMBRE]';\n    pos = end;\n  }\n  return out + text.slice(pos);\n}\n\nfunction pseudonymize(text) {\n  let t = text.replace(EMAIL, '[EMAIL]');\n  t = t.replace(NIE, '[DNI]');\n  t = t.replace(DNI, '[DNI]');\n  t = t.replace(PHONE, '[TELEFONO]');\n  return replaceNames(t);\n}\n\nconst msg = $json.message ?? {};\nreturn { json: { chatId: msg.chat?.id, question: pseudonymize(msg.text ?? '') } };\n"
        }
      },
