# .env.example  (committed — placeholders only)

APP_ENV=development
LOG_LEVEL=info

# Neon (Postgres serverless) — placeholders until `npx neon@latest init` is run
DATABASE_URL=
DIRECT_URL=
# Dedicated Neon branch `test` (direct/unpooled connection) — used only by tests, never `main`.
TEST_DATABASE_URL=

# Retrieval (SPEC-002 R8): cutoff over the normalized ts_rank score (0–1). Empty = code default
# (0.01, see specs/001-rag-retrieval/clarifications.md Q10).
RETRIEVAL_RELEVANCE_THRESHOLD=
NEON_API_KEY=

# Answer generation (SPEC-001, specs/002-answer-generation/plan.md "Configuration").
# Gemini free tier (Google AI Studio): DEVELOPMENT ONLY, with example data and pseudonymized
# questions — production with real patient data requires a paid plan or an EU provider (Q1).
GOOGLE_API_KEY=
GEMINI_MODEL=
# LLM-as-judge for the NFR-03 eval: switchable by config; must differ from GEMINI_MODEL (Q2).
JUDGE_PROVIDER=gemini
JUDGE_MODEL=
# Model timeout in seconds, within NFR-01's 5 s budget. The endpoint never retries (Q12).
LLM_TIMEOUT_SECONDS=4
# Per-token prices (EUR per million tokens) for the cost estimate (R18, NFR-02).
LLM_PRICE_INPUT_EUR_PER_MTOK=
LLM_PRICE_OUTPUT_EUR_PER_MTOK=
# Shared secret with n8n, sent in the X-Api-Token header (R2). Never hard-code it.
CONVERSATION_API_TOKEN=
# Bind address of the application API: loopback only (R3); only n8n's webhook is public.
API_HOST=127.0.0.1
# Evals / load test only: retries after a Gemini 429 (free-tier limits).
EVAL_MAX_RETRIES=6

# Telegram Bot API (PRD DEP-02)
TELEGRAM_BOT_TOKEN=

# n8n — channel adapter: receives the Telegram webhook, calls the FastAPI API over HTTP,
# and relays the response back to Telegram. Instance not deployed yet (Docker + Tailscale
# Funnel planned) — MCP/skills setup is pending until then.
USE_N8N=true
N8N_BASE_URL=
N8N_MCP_TOKEN=
