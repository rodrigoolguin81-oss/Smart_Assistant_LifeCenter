# .env.example  (committed — placeholders only)

APP_ENV=development
LOG_LEVEL=info

# Neon (Postgres serverless) — placeholders until `npx neon@latest init` is run
DATABASE_URL=
DIRECT_URL=
NEON_API_KEY=

# Telegram Bot API (PRD DEP-02)
TELEGRAM_BOT_TOKEN=

# n8n — channel adapter: receives the Telegram webhook, calls the FastAPI API over HTTP,
# and relays the response back to Telegram. Instance not deployed yet (Docker + Tailscale
# Funnel planned) — MCP/skills setup is pending until then.
USE_N8N=true
N8N_BASE_URL=
N8N_MCP_TOKEN=
